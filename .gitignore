# dependencies
node_modules/

# build / runtime
dist/
/data/
*.log

# tooling / local
.superpowers/
.vercel/
.DS_Store
supabase/.temp/

# secrets — never commit real env files (DATABASE_URL, SESSION_SECRET, FIELD_ENCRYPTION_KEY)
.env
.env.*
